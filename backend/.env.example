# Plaid API keys from https://dashboard.plaid.com/team/keys
PLAID_CLIENT_ID=
PLAID_SECRET=

# sandbox, development, or production
PLAID_ENV=sandbox

# Optional server settings
PORT=8000
PLAID_CLIENT_NAME=Personal Finances
APP_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Local PostgreSQL database started by docker compose.
DATABASE_URL=postgresql://personal_finances:personal_finances@localhost:5432/personal_finances

# Supabase credentials are only needed by `npm run db:import:supabase`.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Generate with: openssl rand -base64 32
# Keep this only on the backend host. Rotating it requires re-encrypting saved Plaid tokens.
PLAID_ACCESS_TOKEN_ENCRYPTION_KEY=
